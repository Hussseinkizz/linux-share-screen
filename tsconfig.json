{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"types": ["bun"],
		"paths": {
			"@/*": ["./src/*"]
		},
		"baseUrl": "."
	},
	"include": ["src", "scripts", "electrobun.config.ts", "vite.config.ts"]
}
